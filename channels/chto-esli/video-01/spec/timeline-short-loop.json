{
 "voice": "scratch edge-tts",
 "rate": "n/a",
 "total": 41.2,
 "scenes": [
  {
   "id": "000",
   "text": "— Мелкий, вставай.",
   "start": 0.0,
   "dur": 2.08,
   "speechDur": 1.84,
   "section": "Short"
  },
  {
   "id": "001",
   "text": "Вчера тебе было тридцать три.",
   "start": 2.08,
   "dur": 2.08,
   "speechDur": 1.2,
   "section": "Short"
  },
  {
   "id": "002",
   "text": "Сегодня двенадцатое сентября две тысячи пятого, а в голове двадцать один год вперёд.",
   "start": 4.16,
   "dur": 4.56,
   "speechDur": 4.0,
   "section": "Short"
  },
  {
   "id": "003",
   "text": "Мама выключит свет через час. Пора писать список.",
   "start": 8.72,
   "dur": 4.12,
   "speechDur": 3.8,
   "section": "Short"
  },
  {
   "id": "004",
   "text": "Доллар до осени восьмого. Тополь у гаражей. Папин кредит. Дед. Костин компьютер.",
   "start": 12.84,
   "dur": 7.9,
   "speechDur": 7.6,
   "section": "Short"
  },
  {
   "id": "005",
   "text": "Седьмой пункт — биткоин. До него три с лишним года.",
   "start": 20.74,
   "dur": 4.1,
   "speechDur": 3.18,
   "section": "Short"
  },
  {
   "id": "006",
   "text": "Есть проблема: двенадцатилетним не верят. Они кивают и просят доесть суп.",
   "start": 24.84,
   "dur": 5.32,
   "speechDur": 4.5,
   "section": "Short"
  },
  {
   "id": "007",
   "text": "Ты пишешь быстрее: мелочи уже тают, как сон к обеду.",
   "start": 30.16,
   "dur": 3.66,
   "speechDur": 3.32,
   "section": "Short"
  },
  {
   "id": "008",
   "text": "Мама выключает свет. За стенкой смеётся брат. Ты забыл, как он смеялся.",
   "start": 33.82,
   "dur": 5.98,
   "speechDur": 5.34,
   "section": "Short"
  },
  {
   "id": "009",
   "text": "Утром он зайдёт и скажет:",
   "start": 39.8,
   "dur": 1.4,
   "speechDur": 1.34,
   "section": "Short"
  }
 ],
