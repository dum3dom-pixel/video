 "scenes": [
  {
   "id": "000",
   "text": "Голова тяжёлая, как чугунная сковородка.",
   "start": 0.0,
   "dur": 3.38,
   "speechDur": 3.2,
   "section": "Хук"
  },
  {
   "id": "001",
   "text": "Ковёр на стене. Узкая кровать. Откуда здесь ковёр?",
   "start": 3.38,
   "dur": 4.24,
   "speechDur": 3.74,
   "section": "Хук"
  },
  {
   "id": "002",
   "text": "Заходит брат.",
   "start": 7.62,
   "dur": 1.26,
   "speechDur": 0.8,
   "section": "Хук"
  },
  {
   "id": "003",
   "text": "— Мелкий, вставай.",
   "start": 8.88,
   "dur": 1.54,
   "speechDur": 1.42,
   "section": "Хук"
  },
  {
   "id": "004",
   "text": "Только ему здесь семнадцать, а ты помнишь его взрослым мужиком.",
   "start": 10.42,
   "dur": 4.16,
   "speechDur": 3.62,
   "section": "Хук"
  },
  {
   "id": "005",
   "text": "На календаре двенадцатое сентября две тысячи пятого.",
   "start": 14.58,
   "dur": 3.48,
   "speechDur": 2.82,
   "section": "Хук"
  },
  {
   "id": "006",
   "text": "Вчера тебе было тридцать три.",
   "start": 18.06,
   "dur": 2.26,
   "speechDur": 1.76,
   "section": "Хук"
  }
 ],
